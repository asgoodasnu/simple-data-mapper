{
    "name": "asgoodasnu/simple-data-mapper",
    "type": "symfony-bundle",
    "description": "With this bundle you can easy map your own data.",
    "authors": [
        {
            "name": "Oliver Pintat",
            "email": "oliver.pintat@asgoodasnew.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": ">=6.3.0",
        "symfony/dependency-injection": ">=6.3.0",
        "symfony/http-kernel": ">=6.3.0"
    },
    "autoload": {
        "psr-4": {
            "Asgoodasnew\\SimpleDataMapperBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\Asgoodasnew\\SimpleDataMapperBundle\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^v3.23.0",
        "symfony/phpunit-bridge": "^8.0"
    },
    "scripts": {
        "phpunit": "vendor/bin/phpunit --no-coverage",
        "coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-clover coverage_html/clover-coverage.xml --coverage-html coverage_html --log-junit coverage_html/junit.xml",
        "phpstan": "vendor/bin/phpstan analyse src/ tests/ --level 8",
        "cs-fixer": "PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix",
        "test": [
            "@phpstan",
            "@coverage"
        ]
    }
}
